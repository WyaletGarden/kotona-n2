# Optional local PostgreSQL (compose.local.yaml).
POSTGRES_DB=kotoba
POSTGRES_USER=kotoba
POSTGRES_PASSWORD=change-this-local-password
# Direct Python and default Docker Compose both use DATABASE_URL.
# Aiven: use your service URI with the psycopg driver and TLS:
# DATABASE_URL=postgresql+psycopg://avnadmin:URL_ENCODED_PASSWORD@HOST:PORT/defaultdb?sslmode=require
# Local Python example; compose.local.yaml overrides this to use the db service.
DATABASE_URL=postgresql+psycopg://kotoba:change-this-local-password@localhost:5432/kotoba
APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
SESSION_DAYS=14
AUTH_LIMIT=20
# Optional SQL counts and request timings in Server-Timing headers and API logs.
PERFORMANCE_METRICS=false
