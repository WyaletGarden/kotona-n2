# Docker Compose: change this password before use outside your machine.
POSTGRES_DB=kotoba
POSTGRES_USER=kotoba
POSTGRES_PASSWORD=change-this-local-password
# Direct Python execution; Compose replaces the host with db automatically.
DATABASE_URL=postgresql+psycopg://kotoba:change-this-local-password@localhost:5432/kotoba
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
SESSION_DAYS=14
AUTH_LIMIT=20
